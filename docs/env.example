# Optional: numbers for the metrics cards. Copy to ~/.claude/.env and fill in what you use.
# Leave a line blank to skip that source. Only these five names are read.

# YouTube Data API v3 key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Your channel id (starts with UC): https://www.youtube.com/account_advanced
YOUTUBE_CHANNEL_ID=
# Public handles, without the @
INSTAGRAM_HANDLE=
TIKTOK_HANDLE=
# Optional, raises the GitHub Trending rate limit
GITHUB_TOKEN=
